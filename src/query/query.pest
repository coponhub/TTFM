// --- Whitespace handling ---
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

// --- Main entry point ---
query = { SOI ~ expr ~ EOI }

// --- Set operations (Pratt Parser) ---
expr = { primary ~ (infix ~ primary)* }

infix = _{ ampersand | pipe | minus }
    ampersand = { "&" }
    pipe      = { "|" }
    minus     = { "-" }

// --- Primary elements ---
primary = { complement | factor }

comp_prefix = @{ "^" ~ "(" }
complement = { comp_prefix ~ expr ~ ")" }

// --- Factors ---
// PEG priority: Try specific rules first.
factor = { 
    comparison
  | typed_tag
  | projection
  | "(" ~ expr ~ ")"
}

projection = { type_ref }

// --- Label/Scalar Comparison ---
// DESIGN.md:
// - Label Comparison: Stuck operator (size:>100) or Colon operator (size: :> 100)
// - Scalar Comparison: Space between operand and operator (sum(size:) > 1GB)
// - TypedTag/TypeRef + ScalarOp (size: > 100) is a Syntax Error.

comparison = { 
    label_comparison 
  | scalar_comparison 
}

// Label comparison: operand (including projection) followed by label-style operator
label_comparison = ${ 
    ( (type_ref | calculation) ~ (WHITESPACE+ ~ label_op | stuck_op_step)+ )
  | ( (number | quoted_string) ~ (WHITESPACE* ~ label_op)+ )
  | ( (unquoted_string | unquoted_tag_string) ~ label_op+ )
}
label_op = ${ colon ~ basic_op ~ WHITESPACE* ~ operand }
stuck_op_step = ${ basic_op ~ WHITESPACE* ~ operand }
colon = { ":" }

// Scalar comparison: scalar-only operand followed by scalar-style operator
// Note: projection (type_ref) is NOT allowed in scalar_operand.
scalar_comparison = ${ scalar_operand ~ (WHITESPACE+ ~ basic_op ~ WHITESPACE* ~ operand)+ }

scalar_operand = { calculation | label } // aggregation will be added in future

basic_op = @{ "==" | "^=" | "<=" | ">=" | "^" | ">" | "<" }

// --- Typed Tag ---
// DESIGN.md: type:label (no space allowed between them)
// --- Typed Tag ---
// DESIGN.md: type:label (no space allowed between them)
typed_tag = ${ tag_type ~ ":" ~ tag_label }

// --- Operands ---
operand = { 
    calculation 
  | type_ref 
  | label 
}

// ... existing rules ...

// Tag Label (permissive, allows ^)
tag_label = { quoted_string | number | unquoted_tag_string }

// Unquoted tag string: allows ^ unlike standard unquoted_string
unquoted_tag_string = @{ 
    (escape | (!(WHITESPACE | "&" | "|" | "(" | ")" | "\"" | "'" | "=" | ">" | "<" | "," | ";" | "{" | "}") ~ ANY))+ 
}

// ... existing unquoted_string ...


// --- Label Calculation ---
// DESIGN.md: Arithmetic can ONLY be used inside parentheses of a comparison operand.
calculation = { "(" ~ calculation_inner ~ ")" }
calculation_inner = { operand_calc ~ (arith_op ~ operand_calc)+ }
arith_op = @{ WHITESPACE* ~ ("+" | "-" | "*" | "/" | "%") ~ WHITESPACE* }

// Calc operands (to avoid ambiguity)
operand_calc = { type_ref | label | calculation }

// Type Reference (trailing colon)
type_ref = ${ tag_type ~ ":" }

tag_type = { quoted_string | identifier }

// --- Labels and Literals ---
label = { quoted_string | number | unquoted_string }

// Identifiers (boundary is :)
identifier = @{ (escape | (!reserved_chars ~ ANY))+ }

// Numbers
number = @{ "-"? ~ ASCII_DIGIT+ ~ !("." | ASCII_ALPHANUMERIC | "/") }

// Quoted strings
quoted_string = ${ 
    ("\"" ~ inner_str_double ~ "\"") 
  | ("'" ~ inner_str_single ~ "'") 
}
inner_str_double = @{ (!("\"" | "\\") ~ ANY | "\\" ~ ANY)* }
inner_str_single = @{ (!("'" | "\\") ~ ANY | "\\" ~ ANY)* }

// Unquoted strings: Allow colons in labels.
unquoted_string = @{ 
    (escape | (!(WHITESPACE | "&" | "|" | "(" | ")" | "\"" | "'" | "=" | ">" | "<" | "^" | "," | ";" | "{" | "}") ~ ANY))+ 
}

escape = @{ "\\" ~ ANY }

// Reserved characters are only those that trigger higher-level rules or separators.
// Arithmetic ops (+, *, /, %) are allowed in unquoted strings UNLESS they are in a math context.
reserved_chars = _{ 
    WHITESPACE 
  | "&" | "|" | "(" | ")" | "\"" | "'"
  | "=" | ">" | "<" | "^" // Comparison and assignment-like chars
  | "," | ";" | "{" | "}" 
  | ":"
}
