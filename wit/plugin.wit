package ttfm:plugin;

// プラグインの基本情報を定義する共通インターフェース
interface core {
    enum plugin-kind {
        indexing-function,
    }

    // プラグインが返す値の型（ホストがDBスキーマを決定するために使用）
    enum value-type {
        text,
        big-int,
        boolean,
        double,
    }

    record plugin-info {
        name: string,
        version: string,
        kind: plugin-kind,
        value-type: value-type,
    }

    // プラグインの種別やバージョンを返す
    get-info: func() -> plugin-info;
}

// IndexingFunction (メタデータ抽出) 固有のインターフェース
interface indexing-function {
    // 値のバリアント
    variant tag-value {
        text(string),
        big-int(s64),
        boolean(bool),
        double(f64),
        empty,
    }

    // 指定されたファイルのパスを受け取り、タグ値を返す
    tag-file: func(path: string) -> list<tag-value>;
}

world plugin {
    export core;
    export indexing-function;
}
